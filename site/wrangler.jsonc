{
  // Nitro merges this into the generated .output/server/wrangler.json on every build.
  // `name` must match the Worker in the Cloudflare dashboard exactly (it is "ulm-organizing"),
  // because Workers Builds hard-fails on a mismatch and a Worker cannot be renamed in place.
  "name": "ulm-organizing",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": true }
  },
  // These attach the custom domains on deploy.
  "routes": [
    { "pattern": "upperlevelmusic.com", "custom_domain": true },
    { "pattern": "www.upperlevelmusic.com", "custom_domain": true }
  ]
}
