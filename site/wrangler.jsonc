{
  // Nitro generates .output/server/wrangler.json on every build and merges this
  // file into it. `main` and `assets` are always set by the build — don't add
  // them here or the build warns and ignores them.
  //
  // `name` is pinned because nitro otherwise auto-derives it from the git repo
  // and folder ("lidowe-ulm-organizing-site"), which would become the
  // *.workers.dev hostname.
  "name": "upperlevelmusic",

  // Pinned so the Workers runtime behaviour doesn't silently shift between
  // builds — nitro defaults this to the date the build ran.
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],

  // Attaching the domains here means the first successful deploy also creates
  // the DNS records and issues the certificate — no dashboard step needed.
  // `custom_domain: true` routes ALL paths of the hostname to this Worker.
  //
  // If a deploy fails here, the usual cause is an existing CNAME record on the
  // hostname: Cloudflare refuses to create a Custom Domain over one. Delete the
  // old record in DNS → Records, then redeploy.
  "routes": [
    { "pattern": "upperlevelmusic.com", "custom_domain": true },
    { "pattern": "www.upperlevelmusic.com", "custom_domain": true }
  ]
}
