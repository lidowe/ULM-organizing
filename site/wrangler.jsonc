{
  // Nitro merges this into the generated .output/server/wrangler.json on every build.
  // `name` must match the Worker in the Cloudflare dashboard exactly (it is "ulm-organizing"),
  // because Workers Builds hard-fails on a mismatch and a Worker cannot be renamed in place.
  "name": "ulm-organizing",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": true }
  },
  // Up to 5 form posts per minute per address and endpoint (src/lib/http/guard.ts).
  // namespace_id only has to be unique within the Cloudflare account.
  "ratelimits": [
    { "name": "FORM_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  // Production lives only on the custom domains; every uploaded version and
  // branch build still gets its own preview URL on workers.dev (noindex).
  "workers_dev": false,
  "preview_urls": true,
  // These attach the custom domains on deploy.
  "routes": [
    { "pattern": "upperlevelmusic.com", "custom_domain": true },
    { "pattern": "www.upperlevelmusic.com", "custom_domain": true }
  ]
}
